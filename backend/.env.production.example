# ==============================================================================
# Production Environment Configuration (NFR-14 Image Parity)
# Identical image as staging, differing only in environment variables & secrets
# ==============================================================================
ENVIRONMENT=production
PROJECT_NAME="Personalized Learning Path Recommender (Production)"

# PostgreSQL Production Credentials
POSTGRES_USER=prod_app_user
POSTGRES_PASSWORD=production_super_secret_strong_password_change_me
POSTGRES_DB=learning_recommender_prod
POSTGRES_PORT=5432

# PgBouncer Connection Pooler (Production Sizing)
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_RESERVE_POOL_SIZE=10

# Redis Production
REDIS_HOST=redis
REDIS_PORT=6379

# Application Connectivity through PgBouncer
DATABASE_URL=postgresql://prod_app_user:production_super_secret_strong_password_change_me@pgbouncer:6432/learning_recommender_prod
REDIS_URL=redis://redis:6379/0

# Security (JWT) - Must be a strong 256-bit cryptographic key
SECRET_KEY=production_cryptographic_secret_key_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backup Configuration (NFR-09)
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
