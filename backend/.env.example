# ==============================================================================
# Local Development Environment Configuration
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="Personalized Learning Path Recommender"

# PostgreSQL Direct Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learning_recommender
POSTGRES_PORT=5432

# PgBouncer Connection Pooler (NFR-14)
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_RESERVE_POOL_SIZE=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application URLs (Direct for local without Docker, or PgBouncer in Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_recommender
REDIS_URL=redis://localhost:6379/0

# Security (JWT)
SECRET_KEY=dev_insecure_secret_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backup Configuration (NFR-09)
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
