# ==============================================================================
# Staging Environment Configuration (NFR-14 Image Parity)
# Identical image as production, differing only in environment variables & secrets
# ==============================================================================
ENVIRONMENT=staging
PROJECT_NAME="Personalized Learning Path Recommender (Staging)"

# PostgreSQL Staging Credentials
POSTGRES_USER=staging_app
POSTGRES_PASSWORD=staging_secure_pass_987654321
POSTGRES_DB=learning_recommender_staging
POSTGRES_PORT=5432

# PgBouncer Connection Pooler (Staging Sizing)
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=150
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5

# Redis Staging
REDIS_HOST=redis
REDIS_PORT=6379

# Application Connectivity through PgBouncer
DATABASE_URL=postgresql://staging_app:staging_secure_pass_987654321@pgbouncer:6432/learning_recommender_staging
REDIS_URL=redis://redis:6379/0

# Security (JWT)
SECRET_KEY=staging_cryptographic_secret_key_random_hex_string_abc123
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backup Configuration (NFR-09)
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
